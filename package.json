{
  "name": "ai-shopify-superapp",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.20.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter web dev",
    "shopify:dev": "shopify app dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter \"web^...\" run --if-present build && pnpm --filter web exec prisma generate && pnpm -r test",
    "test:packages": "pnpm --filter \"web^...\" run --if-present build && pnpm --filter web exec prisma generate && pnpm -r --filter \"!./extensions/**\" test",
    "test:functions": "pnpm -r --filter \"./extensions/**\" test",
    "lint": "pnpm -r lint",
    "evals": "pnpm --filter web evals",
    "evals:strict": "pnpm --filter web evals --strict",
    "prepare": "husky",
    "deploy:validate": "pnpm --filter web exec tsx ../../scripts/deployment/validate-config.ts",
    "test:deployment": "pnpm --filter web exec vitest run --config ../../scripts/deployment/vitest.config.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vitest": ">=3.2.6 <4"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=8.0.1",
      "shell-quote": ">=1.8.4",
      "vitest": ">=3.2.6 <4",
      "ioredis": "^5.11.1"
    }
  },
  "lint-staged": {
    "apps/web/app/**/*.{ts,tsx}": [
      "pnpm --filter web eslint --fix"
    ],
    "**/*.{ts,tsx,js}": [
      "bash -c 'pnpm -r --if-present typecheck'"
    ],
    "**/shopify.app*.toml": [
      "node scripts/check-shopify-config.mjs"
    ],
    "**/shopify.extension.toml": [
      "node scripts/check-shopify-config.mjs"
    ]
  }
}
