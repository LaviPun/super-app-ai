DATABASE_URL="postgresql://superapp:superapp@localhost:5433/superapp"
SHOPIFY_API_KEY="replace-with-app-client-id"
SHOPIFY_API_SECRET="replace-with-app-client-secret"
SHOPIFY_APP_URL="http://localhost:3000"
# Comma-separated; must match shopify.app.toml [access_scopes]. Required even for dev:internal (port 4000).
SCOPES="read_customers,read_metaobjects,read_products,read_themes,write_app_proxy,write_customers,write_metaobjects,write_orders"
ENCRYPTION_KEY="replace-with-32-byte-base64-key"

LLM_PROVIDER="openai"  # default AI for env path: openai | claude | gemini
OPENAI_API_KEY="replace-with-openai-api-key"
# Must be a real OpenAI model id (docs/ai-providers.md §pitfalls: NOT gpt-5-mini)
OPENAI_DEFAULT_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-6"
ANTHROPIC_SKILLS=""
ANTHROPIC_CODE_EXECUTION="false"

# Google Gemini (main code-gen chatbot). Configure in /internal/ai-providers (DB) or via env here.
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

INTERNAL_ADMIN_PASSWORD="replace-with-strong-password"
INTERNAL_ADMIN_SESSION_SECRET="replace-with-random-secret"

INTERNAL_SSO_ISSUER="https://accounts.google.com"
INTERNAL_SSO_CLIENT_ID="replace-with-oidc-client-id"
INTERNAL_SSO_CLIENT_SECRET="replace-with-oidc-client-secret"
INTERNAL_SSO_REDIRECT_URI="https://your-app.example.com/internal/sso/callback"
# Required when INTERNAL_SSO_ISSUER is set: comma-separated allowlist of emails granted internal admin via SSO.
INTERNAL_SSO_ALLOWED_EMAILS="you@example.com,teammate@example.com"

DEFAULT_RETENTION_DAYS="30"
CRON_SECRET="replace-with-long-random-secret"
# In-process cron scheduler (worker service; docs/operations.md §Cron). Default ON: the worker
# runs the scheduled sweeps every CRON_TICK_INTERVAL_MINUTES (default 5; also the Redis lock TTL).
# Set CRON_SCHEDULER_ENABLED=false ONLY if an external scheduler is calling /api/cron instead.
# CRON_SCHEDULER_ENABLED="true"
# CRON_TICK_INTERVAL_MINUTES="5"
# AI daily spend soft cap in cents (observability only — alert + admin banner, never blocks).
# Unset = 2000 ($20/day). Set <= 0 to disable. AppSettings.aiDailySpendCapCents overrides.
# AI_DAILY_SPEND_CAP_CENTS="2000"

INTERNAL_AI_ROUTER_URL="https://replace-with-router-url"
INTERNAL_AI_ROUTER_TOKEN="replace-with-router-token"
INTERNAL_AI_ROUTER_SHADOW="true"
# INTERNAL_AI_LOCAL_ONLY="1"   # optional: internal AI assistant — local sends only (no modal / no cross-target failover)
# INTERNAL_AI_ALLOW_HOSTS="localhost,127.0.0.1"  # optional allowlist for internal assistant HTTP target checks
# INTERNAL_AI_TOOL_AUDIT_RETENTION_DAYS="90"      # optional tool-audit retention window
# INTERNAL_AI_CHAT_MESSAGE_RETENTION_DAYS="30"    # optional internal assistant message retention window
REDIS_URL="redis://127.0.0.1:6379"
QUEUE_REDIS_URL="redis://127.0.0.1:6379"
JOB_EXECUTION_MODE="inline"
PREVIEW_EXPORT_QUEUE_ENABLED="1"

# App Pricing plan sync (Partner API). All optional — inert without them (see docs/runbooks/app-pricing-setup.md).
# SHOPIFY_PARTNER_API_TOKEN="replace-with-partner-api-client-token"   # Partner API client with "Manage apps" permission
# SHOPIFY_PARTNER_ORG_ID="replace-with-numeric-org-id"                # numeric id from partners.shopify.com/<org_id>/…
# SHOPIFY_APP_GID="gid://shopify/App/replace-with-app-id"             # this app's Admin API gid
# SHOPIFY_APP_HANDLE="replace-with-app-handle"                        # app listing handle (expected super-app-ai — verify, don't assume)
